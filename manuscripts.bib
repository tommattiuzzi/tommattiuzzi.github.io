@unpublished{presotto2026negativedoubling,
  author       = {Presotto, Giacomo and Mattiuzzi, Tommaso and Poletto, Cecilia},
  title        = {Negative Doubling is Doubling},
  note         = {Manuscript submitted for publication},
  year         = {2026},
  month        = {4},
  keywords     = {Negative Concord, Negative Doubling, Syntactic Doubling, NCIs, Negation},
  abstract     = {We provide a movement account of Negative Doubling, a subcase of Negative Concord defined as the co-occurrence of a negative indefinite with a sentential negative marker yielding a single negation reading. This proposal rests on the idea that the two elements involved in a Negative Doubling configuration initially form a constituent as part of the extended projection of the negative indefinite, which can be split by movement. We analyze the basic typological distinction among Strict and Non-Strict Negative Concord (NC) Languages as the result of the parametrized availability of different movement options: splitting is generalized in Strict NC systems, whereas it only applies in a subset of configurations in Non-Strict systems, namely those where the target position of the negative indefinite is structurally lower than the regular locus of encoding of sentential negation. This proposal establishes a parallel between Negative Doubling and the syntactic mechanisms independently proposed to account for other instances of syntactic doubling, like Clitic Doubling. Furthermore, it captures two core empirical observations: i) no known language exhibits Negative Doubling when an indefinite precedes the inflected verb, but not when it follows it (a generalization we dub 'Anti-Non-Strict NC' gap); ii) some languages overtly realize the sentential negative marker and a negative indefinite as a single constituent, as supported by evidence from Occitan and Dutch varieties.}
}


