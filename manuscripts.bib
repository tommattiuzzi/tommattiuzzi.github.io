@misc{PresottoMattiuzzi2026,
  title = {\O{}ut of {{Order}} --{{The Empty Set}} and {{Intervention}} in {{Featural Relativised Minimality}}},
  author = {Presotto, Giacomo and Mattiuzzi, Tommaso},
  year = 2026,
  month = jul,
  publisher = {LingBuzz},
  urldate = {2026-07-23},
  abstract = {This technical note proposes a partial revision of the formalisation of Relativised Minimality (RM; Rizzi1990,Rizzi2004,Rizzi2018) -- the most well-known account of intervention locality effects. RM, as currently defined, draws on set-theoretic relations: Identity, Inclusion, Intersection, and Disjunction. While all are typically used in presentations of the theory, we argue that Disjunction should be excluded, as it entails a formal contradiction. We propose instead that disjunction cases fall outside the scope of RM-computations, as the relevant structural configurations lack an intervener altogether. This move also avoids certain set-theoretical issues involving the empty set.},
  archiveprefix = {LingBuzz},
  keywords = {empty set,relativised minimality,set theory,syntax},
  annotation = {LingBuzz Published In:},
  file = {C:\Users\tommattzz\Nextcloud\zotero-full-texts\storage\8IVW4W3L\Presotto and Mattiuzzi - 2026 - Øut of Order --The Empty Set and Intervention in Featural Relativised Minimality.pdf}
}

@misc{Mattiuzzi2026,
  title = {Catalan Numbers and the Theoretical Limits of Morphosyntactic Variation},
  author = {Mattiuzzi, Tommaso},
  year = 2026,
  month = aug,
  publisher = {LingBuzz},
  urldate = {2026-08-03},
  abstract = {The number of possible binary trees is a function of the number of leaves in the tree. The growth of this function coincides with the series of Catalan numbers, a numerical sequence with many applications in the domain of enumerative combinatorics. As Collins (2022) recognizes, this numerical sequence specifies a theoretical limit on possible ways a string can be parsed via binary Merge. In this paper, I demonstrate that the nanosyntactic Lexicalization Algorithm (Starke 2018, DeClercq et al. 2025) bounds the number of possible outputs of derivations building and externalizing structure in a single Workspace exactly to the Catalan numbers. I then discuss how this result enables a mathematical characterization of the power of a generative grammar building observable linguistic objects from a given selection of input elements. By determining the space of possibilities open in an abstract derivational system, it becomes possible to quantitatively study the role of the independent factors that determine how languages fill this space. From this perspective, the Catalan numbers emerge as fundamental to the understanding of morphosyntactic variation as the result of the interaction of the First and the Third factor (Chomsky2005).},
  note = {Companion interactive notebook with visualizations of the nanosyntactic Lexicalization Algorithm — runs in your browser via Binder.},
  url_Notebook = {https://mybinder.org/v2/gh/tommattiuzzi/nanosyntactic-lexicalization-algorithm/HEAD?urlpath=%2Fdoc%2Ftree%2Fvisualization.ipynb},
  archiveprefix = {LingBuzz},
  keywords = {algorithm,derivation,nanosyntax,possibility space,syntax},
  annotation = {LingBuzz Published In: manuscript}
}

