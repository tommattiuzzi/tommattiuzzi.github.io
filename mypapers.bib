  abstract = {{$<$}p{$>$}Certain English quantificational expressions feature what appears to be an indefinite article, e.g. {$<$}em{$>$}a bunch, a few, a hundred{$<$}/em{$>$}. These can be divided into three types of quantifying expressions: pseudopartitives ({$<$}em{$>$}a lot, a bunch, a ton{$<$}/em{$>$}), article-requiring quantifiers ({$<$}em{$>$}a few, a couple, a hundred{$<$}/em{$>$}), and article-free quantifiers ({$<$}em{$>$}three, many, several{$<$}/em{$>$}); article-free quantifiers have an article under certain circumstances, e.g. modification by an adjective ({$<$}em{$>$}a surprising 30 \dots{$<$}/em{$>$}). While standard analyses would take the article in these expressions to be a D head, it is argued here that the article is not in D, nor is it singular or count, as evidenced by its (lack of an) interaction with verbal agreement. Instead, it is claimed that {$<$}em{$>$}a(n){$<$}/em{$>$} is a default cardinality marker, which surfaces when a QP is present, but fails to be spelled-out by other material. The distribution of default {$<$}em{$>$}a(n){$<$}/em{$>$} further interacts with adjective placement ({$<$}em{$>$}a surprising 30{$<$}/em{$>$}), plural marking on some quantifiers ({$<$}em{$>$}tons of{$<$}/em{$>$}), other determiners ({$<$}em{$>$}the hundred{$<$}/em{$>$}), and the functional status of the quantifier ({$<$}em{$>$}a wealth of{$<$}/em{$>$} vs. {$<$}em{$>$}a lot{$<$}/em{$>$}). The resemblance of this article to the English indefinite article {$<$}em{$>$}a(n){$<$}/em{$>$} is also considered, and a possible unifying analysis is given.{$<$}/p{$>$}},
  langid = {english},
  file = {C:\Users\tommattzz\Nextcloud\zotero-full-texts\storage\KRQDWPMI\Klockmann - 2020 - The article a(n) in English quantifying expression.pdf}
}

@article{KnooihuizenEtAl2016,
  title = {The Future of Dialects: {{Selected}} Papers from {{Methods}} in {{Dialectology XV}}},
  shorttitle = {The Future of Dialects},
  author = {Knooihuizen, Remco and Nerbonne, John and C{\^o}t{\'e}, Marie-H{\'e}l{\`e}ne and Nagy, Naomi and Ghyselen, Anne-Sophie and Llop Naya, Ares and Pickl, Simon and Mathussek, Andreas and Montemagni, Simonetta and Wieling, Martijn and {Brun-Trigaud}, Guylaine and Solliec, Tanguy and Le D{\^u}, Jean and Bloem, Jelke and Kendall, Tyler and Fridland, Valerie and Stoeckle, Philipp and Wolk, Christoph and Szmrecsanyi, Benedikt and Sch{\"a}fer, Lea and Leser, Stephanie and Cysouw, Michael and Lara Bermejo, V{\'i}ctor and {\v S}kevin, Ivana and Hirano, Keiko and Carignan, Christopher and Mielke, Jeff and Dodsworth, Robin and Spreafico, Lorenzo and Kumagai, Yasuo and Fukushima, Chitsuko and Onishi, Takuichiro and Ota, Ichiro and Utsugi, Akira and Nikaido, Hitoshi},
  year = 2016,
  journal = {Language Variation},
  pages = {39.86 MB},
  publisher = {Language Science Press},
  issn = {2366-7818},
  doi = {10.17169/LANGSCI.B81.78},
  urldate = {2022-12-12},
  abstract = {Traditional dialects have been encroached upon by the increasing mobility of their speakers and by the onslaught of national languages in education and mass media. Typically, older dialects are ``leveling'' to become more like national languages. This is regrettable when the last articulate traces of a culture are lost, but it also promotes a complex dynamics of interaction as speakers shift from dialect to standard and to intermediate compromises between the two in their forms of speech. Varieties of speech thus live on in modern communities, where they still function to mark provenance, but increasingly cultural and social provenance as opposed to pure geography. They arise at times from the need to function throughout the different groups in society, but they also may have roots in immigrants' speech, and just as certainly from the ineluctable dynamics of groups wishing to express their identity to themselves and to the world.  The future of dialects is a selection of the papers presented at Methods in Dialectology XV, held in Groningen, the Netherlands, 11-15 August 2014. While the focus is on methodology, the volume also includes specialized studies on varieties of Catalan, Breton, Croatian, (Belgian) Dutch, English (in the US, the UK and in Japan), German (including Swiss German), Italian (including Tyrolean Italian), Japanese, and Spanish as well as on heritage languages in Canada.},
  copyright = {CC-BY},
  langid = {english},
  keywords = {methodology}
}

