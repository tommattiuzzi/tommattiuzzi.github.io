@misc{Ahn2020,
  title = {{{THAT}} Thesis: {{A}} Competition Mechanism for Anaphoric Expressions [{{PhD}} Thesis]},
  shorttitle = {{{THAT}} Thesis},
  author = {Ahn, Dorothy},
  year = 2020,
  month = apr,
  publisher = {LingBuzz},
  urldate = {2022-12-30},
  abstract = {This dissertation is concerned with anaphoric expressions that refer to familiar entities in a discourse. Referent tracking studies tell us that anaphoric expressions such as null arguments, pronouns, and definite descriptions differ in their relative frequency and distribution. In this thesis, I explore how this distribution can be derived from underlying denotations and structures of these expressions. All anaphoric expressions are argued to share one underlying basic structure, and only differ in the number of restrictions they carry. This derives a scale that is ordered by semantic strength, and an economy-based principle requires that the least redundant form be used when multiple expressions are available. This competition mechanism is assumed to be universally available, with cross-linguistic differences resulting from languages lexicalizing different sets of denotations. With language-specific lexicalizations assumed, this mechanism provides a uniform analysis for a wide range of phenomena: competition between overt and covert pronouns, blocking of the anaphoric bare noun in some bare argument languages, markedness of demonstratives, as well as the distribution of different types of indexical pointing in American Sign Language.},
  archiveprefix = {LingBuzz},
  keywords = {anaphoric expressions,asl,bare arguments,competition,definiteness,demonstratives,familiarity,ix,pronouns,reference,semantics,semantics/pragmatics},
  annotation = {LingBuzz Published In: PhD thesis, Harvard University},
