@incollection{Grunwald1996,
  title = {A Minimum Description Length Approach to Grammar Inference},
  booktitle = {Connectionist, {{Statistical}} and {{Symbolic Approaches}} to {{Learning}} for {{Natural Language Processing}}},
  author = {Gr{\"u}nwald, Peter},
  editor = {Wermter, Stefan and Riloff, Ellen and Scheler, Gabriele and Carbonell, Jaime G. and Siekmann, J{\"o}rg and Goos, G. and Hartmanis, J. and Leeuwen, J.},
