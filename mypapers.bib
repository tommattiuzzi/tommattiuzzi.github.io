@article{GuardianoEtAl2022,
  title = {Number {{Morphology}} and {{Bare Nouns}} in {{Some Romance Dialects}} of {{Italy}}},
  author = {Guardiano, Cristina and Cambria, Michela and Stalfieri, Vincenzo},
  year = 2022,
