@misc{CahaMedova2023,
  title = {Syncretism and Markedness Paradoxes in the {{Russian}} Demonstrative Declension},
  author = {Caha, Pavel and Medov{\'a}, Lucie Taraldsen},
  year = 2023,
  month = aug,
  publisher = {LingBuzz},
  urldate = {2023-08-30},
  abstract = {This paper investigates the singular declension of Russian demonstratives and nouns. These paradigms pose an interesting set of challenges for standard theories of paradigm structure. Specifically, it has been claimed that neutralisation of grammatical distinctions (like gender) happens in marked cases, while distinctions are preserved in unmarked cases like NOM/ACC. However, when we compare demonstratives and nouns in Russian, we observe the exact opposite pattern: they are syncretic in the unmarked, structural cases, but differentiated throughout the marked, oblique cases. This paper shows that the complex and apparently unusual patterns of morpheme distributions as attested in Russian can be insightfully modelled using the cross-linguistically invariant lexicalisation procedure proposed within Nanosyntax.},
  archiveprefix = {LingBuzz},
  keywords = {declension,demonstratives,morphology,nanosyntax,nouns,russian},
  annotation = {LingBuzz Published In: written for a volume on Nanosyntax},
  file = {C\:\\Users\\tommattzz\\Nextcloud\\zotero-full-texts\\storage\\R8FMA7PB\\Caha and Medová - 2023 - Syncretism and markedness paradoxes in the Russian.pdf;C\:\\Users\\tommattzz\\Nextcloud\\zotero-full-texts\\storage\\TJEHUIYM\\007511.html}
}

