}

@article{TubauEtAl2018,
  title = {How Speakers Interpret the Negative Markers No and No\dots pas in {{Catalan}}},
  author = {Tubau, Susagna and D{\'e}prez, Viviane and {Borr{\`a}s-Comes}, Joan and Espinal, M. Teresa},
  year = 2018,
