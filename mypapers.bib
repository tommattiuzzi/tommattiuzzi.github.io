@article{EspinalLlop2022,
  title = {({{Negative}}) {{Polarity Items}} in {{Catalan}} and {{Other Trans-Pyrenean Romance Languages}}},
  author = {Espinal, M. Teresa and Llop, Ares},
  year = 2022,
  month = feb,
