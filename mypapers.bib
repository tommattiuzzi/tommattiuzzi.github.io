@incollection{Postma2017,
  title = {Modelling Transient States in Language Change},
  booktitle = {Micro-Change and {{Macro-change}} in {{Diachronic Syntax}}},
  author = {Postma, Gertjan},
  editor = {Mathieu, Eric and Truswell, Robert},
  year = 2017,
  month = jul,
  edition = {1},
  pages = {75--93},
  publisher = {Oxford University PressOxford},
  doi = {10.1093/oso/9780198747840.003.0006},
  urldate = {2026-05-19},
  abstract = {Abstract Models of language change may include, apart from the initial and terminal state, an intermediate state T. Building further on Postma (2010), who observed that the dynamics of the transient state T ('failed change') is algebraically related to the overall change A {$\rightarrow$} B (the former is the first derivative of the latter), we present a generalized algebraic model that includes both the failed change A {$\rightarrow$} B and the successful change A {$\rightarrow$} B. We first generalize the two-state logistic function of A {$\rightarrow$} B to a differential equation (DE) that represents the underlying processes. This DE has a bundle of time shifted logistic curves as its solution. This derives Kroch's Constant Rate Effect. By modifying this DE, we describe the dynamics of the entire A {$\rightarrow$} T {$\rightarrow$} B process, i.e. we develop a model that includes both the successful and the failed change. The algebraic link between failed change and successful change turns out to be an approximation.},
  isbn = {978-0-19-874784-0 978-0-19-181073-2},
  langid = {english}
}

