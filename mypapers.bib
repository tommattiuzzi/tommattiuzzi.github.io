@article{Valenzuela2010,
  title = {Cognitive Linguistics and Computational Modeling},
  author = {Valenzuela, Javier},
  year = 2010,
  month = oct,
  journal = {Textus},
  volume = {23},
  pages = {763--794},
  abstract = {Computational modeling is an extremely useful tool when studying any complex system, be it weather prediction, protein folding, brain functioning or language, to name just a few potential applications. A carefully-designed computational model can help theoretical proposals by providing clues about their limitations or internal contradictions and, generally speaking, allowing us to better understand their intricacies and implications; it additionally places quite strict requirements on theories, which must be presented in a completely explicit, detailed and precise way. There are relatively few cognitive linguistic computational implementations (compared to, say, generative approaches). In the present work, we review some of the most influential cognitive linguistic computational models, paying special attention to pioneering work such as Harris (1990) connectionist implementation of ``over'' networks, to the work coming from the International Computer Science Institute (e.g., Regier's model, Narayan's work and Embodied Construction Grammar) as well as the research efforts by Steels and colleagues, which offer yet another approach to the implementation of cognitive semantics and construction grammar, this time using a robotic platform},
  file = {C:\Users\tommattzz\Nextcloud\zotero-full-texts\storage\BHUZ55G8\Valenzuela - 2010 - Cognitive linguistics and computational modeling.pdf}
}

