}

@incollection{GiannakidouZeijlstra2017,
  title = {The {{Landscape}} of {{Negative Dependencies}}: {{Negative Concord}} and {{N-Words}}},
  shorttitle = {The {{Landscape}} of {{Negative Dependencies}}},
  booktitle = {The {{Wiley Blackwell Companion}} to {{Syntax}}, {{Second Edition}}},
  author = {Giannakidou, Anastasia and Zeijlstra, Hedde},
  year = 2017,
  pages = {1--38},
  publisher = {John Wiley \& Sons, Ltd},
  doi = {10.1002/9781118358733.wbsyncom102},
  urldate = {2024-08-21},
  abstract = {This chapter updates an earlier discussion of n-words and negative concord (NC) offered by the first author. Our goal here is to address the considerable developments in the area of n-words and NC that took place since 2006. As the title suggests, we study negative dependencies within the context of negative dependencies. We have chosen this term as a theory-neutral way to refer to phenomena that in one way or another involve dependency of an expression on the presence of negation. Several major negative dependencies can be distinguished; negative polarity, NC, negative quantifiers in Germanic languages, and even the expression of negation itself have been discussed in this context. Negative dependencies form a landscape: they share a space as grammatical phenomena, for instance sensitivity to the presence of negation -- but, at the same time, the dependencies are not identical. For instance, the need for negation of a negative polarity item such as any does not derive from the same source as the need of negation for an n-word, which has a more narrow distribution than any. And within the class of n-words (the main focus of this chapter) there is considerable variation as well. Our approach is inspired by a long tradition of polarity research that acknowledges diversity and the fact that polarity phenomena are lexically driven. In presenting the phenomena, we apply a compositional perspective by connecting the nature of the sensitivity to the morphosyntactic, semantic, or pragmatic properties of the negation-sensitive items.},
  copyright = {Copyright \copyright{} 2017 John Wiley \& Sons, Inc.},
  isbn = {978-1-118-35873-3},
  langid = {english},
  keywords = {grammar,semantics,syntax},
  file = {C\:\\Users\\tommattzz\\Nextcloud\\zotero-full-texts\\storage\\DU7I9LRL\\9781118358733.html;C\:\\Users\\tommattzz\\Nextcloud\\zotero-full-texts\\storage\\NSVSYQLV\\9781118358733.html}
}

