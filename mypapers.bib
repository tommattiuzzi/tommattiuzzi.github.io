@misc{Tanaka2022,
  title = {Derivation by {{Merge}} and {{Its Input Restriction}}},
  author = {Tanaka, Hideharu},
  year = 2022,
  month = jul,
  publisher = {LingBuzz},
  urldate = {2023-05-26},
  abstract = {This paper explores the applicability of the structure-building operation Merge, addressing how its input search is independently restricted. The issue is discussed in light of an Anti-stacking Effect (ASE), which is a generalization subsuming a Case Adjacency Effect and states that no adverb phrase occurs above a head that shares matching features with an element at its edge. To derive the ASE in a principled fashion, it is proposed that derivation by Merge is constrained by a Matching Search Condition (MSC), under which if the head of one input X to Merge holds feature matching inside X, then the search for the other input Y is limited and cannot select any non-matching objects in the workspace. It is shown that the MSC deduces all instances of the ASE found in the domains of VP and CP, and even covers a crosslinguistic variation in the distribution of adverb phrases, once the varying height of verb raising across languages is considered. A notable implication of the entire theory is that Merge should only be constrained in terms of input restrictions and interface conditions, suggesting that no output restrictions internal to the computational system are required.},
  archiveprefix = {LingBuzz},
  keywords = {adverbs,case,feature matching,input search,merge,semantics,syntax,workspaces},
  annotation = {LingBuzz Published In: Manuscript},
  file = {C\:\\Users\\tommattzz\\Nextcloud\\zotero-full-texts\\storage\\4BJREGHY\\Tanaka - 2022 - Derivation by Merge and Its Input Restriction.pdf;C\:\\Users\\tommattzz\\Nextcloud\\zotero-full-texts\\storage\\DJNXYK4S\\006723.html}
}

