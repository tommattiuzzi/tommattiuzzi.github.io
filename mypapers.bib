@inproceedings{AycockAycock2020,
  title = {A {{Third-Factor Account}} of {{Locality}}: {{Explaining}} Impenetrability and Intervention Effects with Minimal Search},
  shorttitle = {A Ird-{{Factor Account}} of {{Locality}}},
  author = {Aycock, Seth},
  year = 2020,
  urldate = {2026-02-20},
  abstract = {Current approaches to locality focus on two central ideas, intervention and impenetrability, aempting to explain the former with Relativized Minimality (Rizzi 1990, 2001, 2011, Starke 2001) and the laer with the Phase Impenetrability Condition from Chomsky's Phase eory (Chomsky 2000, 2001, 2008). Some redundancy exists between the two constraints. In this paper, I propose an account deriving both intervention and impenetrability eects from minimal search. Minimal search is an optimal reex of the third-factor notion of minimal computation. is paper details an account which derives an intervention principle of Probe Closest Goal, the Phase Impenetrability Condition and Antilocality from narrow syntax while removing several stipulated principles from the grammar. e approach also provides accounts for empirical data in a parsimonious manner. is paper thus presents a theoretically and empirically motivated third-factor account of locality, oering a useful foundation for future work.}
}

