@article{Aguilar-GuevaraOggiani2023,
  title = {Weak Definite Nominals},
  author = {{Aguilar-Guevara}, Ana and Oggiani, Carolina},
  year = 2023,
  month = dec,
  journal = {Language and Linguistics Compass},
  volume = {17},
