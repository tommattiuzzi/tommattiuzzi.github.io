  urldate = {2026-06-10},
  abstract = {Abstract             This chapter investigates a puzzle posed by traditional and contemporary approaches to the lexicon: words (lexical items) are conceived of as both complex and atomic units. Such puzzle has been the focus of much research, with consequences for the overall architecture of grammar, the debate between decompositionalists and atomists, and the study of microparametric variation. The chapter reviews the arguments that have been provided to treat words as primitive units of computation that nonetheless have a rich internal structure (``atomic complexes,'' as it were), and suggest that this dual character follows from the way computational devices and memory resources interact. In particular, it is argued that the word-internal structure is created through Merge (the only structure-building operation) and later on rendered opaque through a process of reprojection.},
  isbn = {978-0-19-046173-7 978-0-19-046176-8},
  langid = {english}
}

@article{GallegoOrus2022,
  title = {Language {{Design}} as {{Information Renormalization}}},
  author = {Gallego, {\'A}ngel J. and Or{\'u}s, Rom{\'a}n},
  year = 2022,
  month = jan,
  journal = {SN Computer Science},
