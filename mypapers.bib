@article{Ledgeway2021,
  title = {The Syntactic Distribution of Raddoppiamento Fonosinttatico in {{Cosentino}}: {{A}} Phase-Theoretic Account},
  shorttitle = {The Syntactic Distribution of Raddoppiamento Fonosinttatico in {{Cosentino}}},
