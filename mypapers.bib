@incollection{FasanellaFortuny2016,
  title = {Deriving Linguistic Variation from Learnability Conditions: {{The Chunking Procedure}}},
  shorttitle = {Deriving Linguistic Variation from Learnability Conditions},
  booktitle = {Rethinking {{Parameters}}},
  author = {Fasanella, Adriana and Fortuny, Jordi},
