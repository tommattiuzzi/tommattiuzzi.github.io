  shorttitle = {Negation Detection for Sentiment Analysis},
  author = {{Jim{\'e}nez-Zafra}, Salud Mar{\'i}a and {Cruz-D{\'i}az}, Noa P. and Taboada, Maite and {Mart{\'i}n-Valdivia}, Mar{\'i}a Teresa},
